{% extends "base.html" %} {% block title %}Pre-Auth Cost Estimator - Bill
Buster{% endblock %} {% block extra_head %}
<link
  rel="stylesheet"
  href="{{ url_for('static', filename='css/bill_buster.css') }}?v=2"
/>
<link
  rel="stylesheet"
  href="{{ url_for('static', filename='css/bill_buster_enhanced.css') }}?v=2"
/>
<link
  rel="stylesheet"
  href="{{ url_for('static', filename='css/modern_plan_card.css') }}?v=2"
/>
<link
  rel="stylesheet"
  href="{{ url_for('static', filename='css/compare_modal.css') }}?v=2"
/>
<style>
  .preauth-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .procedure-card {
    transition: all 0.3s ease;
  }

  .procedure-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .estimate-card {
    animation: slideIn 0.4s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
{% endblock %} {% block content %}
<div class="preauth-container">
  <!-- Header -->
  <div class="text-center mb-8">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">
      Pre-Authorization Cost Estimator
    </h1>
    <p class="text-lg text-gray-600 max-w-3xl mx-auto">
      Find out how much your medical procedure will cost out-of-pocket across
      different insurance plans. We'll help you choose the plan that saves you
      the most money.
    </p>
  </div>

  <!-- Info Banner -->
  <div
    class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-6 mb-8"
  >
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <svg
          class="h-6 w-6 text-blue-600"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-blue-900">💡 How it works</h3>
        <div class="mt-2 text-sm text-blue-800">
          <ul class="list-disc list-inside space-y-1">
            <li>Select the medical procedure you need</li>
            <li>
              We calculate your out-of-pocket costs across 50+ insurance plans
            </li>
            <li>See which plan saves you the most money</li>
            <li>
              Get detailed cost breakdowns including deductibles, co-pays, and
              network discounts
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Estimator Form -->
  <div class="bg-white rounded-2xl shadow-xl p-8 mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Estimate Your Costs</h2>

    <form id="preauth-form" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Procedure Selection -->
        <div>
          <label
            for="procedure_select"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Select Procedure *
          </label>
          <select
            id="procedure_select"
            name="procedure_code"
            class="w-full border-2 border-gray-200 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
            required
          >
            <option value="">-- Choose a procedure --</option>
            {% for row in procedures %}
            <option value="{{ row.procedure_code }}">
              {{ row.procedure_name }} — ₹{{ "{:,}".format(row.avg_cost|int) }}
              avg
            </option>
            {% endfor %}
          </select>
          <p class="text-xs text-gray-500 mt-1">
            Common procedures from our database
          </p>
        </div>

        <!-- Current Plan (Optional) -->
        <div>
          <label
            for="current_plan_select"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Your Current Plan (Optional)
          </label>
          <select
            id="current_plan_select"
            name="current_plan_id"
            class="w-full border-2 border-gray-200 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
          >
            <option value="">(compare all plans)</option>
            {% for p in plans[:30] %}
            <option value="{{ p.plan_id or p.planid }}">
              {{ p.provider }} — {{ p.plan_name }}
            </option>
            {% endfor %}
          </select>
          <p class="text-xs text-gray-500 mt-1">
            We'll show potential savings vs. your current plan
          </p>
        </div>
      </div>

      <!-- Action Button -->
      <div class="flex items-center gap-4">
        <button
          id="estimate_btn"
          type="button"
          class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-3 px-8 rounded-lg shadow-lg transition-all transform hover:scale-105"
        >
          🔍 Calculate Estimates
        </button>
        <span id="loading_spinner" class="hidden text-gray-600">
          <svg
            class="inline animate-spin h-6 w-6 mr-2"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
          Calculating...
        </span>
      </div>
    </form>
  </div>

  <!-- Results Container -->
  <div id="estimate_result"></div>

  <!-- Feedback Panel -->
  <div
    id="feedback_panel"
    class="hidden bg-white rounded-2xl shadow-xl p-8 mt-8"
  >
    <h3 class="text-2xl font-bold text-gray-900 mb-4">📝 Submit Actual Cost</h3>
    <p class="text-gray-600 mb-6">
      Help us improve our estimates by sharing the actual out-of-pocket cost you
      paid. Your feedback makes our predictions more accurate for everyone.
    </p>

    <form id="feedback_form" class="space-y-4">
      <input type="hidden" id="fb_procedure" name="procedure_code" />
      <input type="hidden" id="fb_plan_id" name="plan_id" />
      <input type="hidden" id="fb_estimated_oop" name="estimated_oop" />

      <div>
        <label
          for="actual_oop"
          class="block text-sm font-semibold text-gray-700 mb-2"
        >
          Actual Out-of-Pocket Cost (₹)
        </label>
        <input
          id="actual_oop"
          name="actual_oop"
          type="number"
          step="0.01"
          class="w-full border-2 border-gray-200 rounded-lg p-3 focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
          placeholder="e.g., 25000"
        />
      </div>

      <div class="flex gap-3">
        <button
          id="feedback_submit"
          type="button"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-6 rounded-lg transition"
        >
          Submit Feedback
        </button>
        <button
          id="feedback_cancel"
          type="button"
          class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold py-3 px-6 rounded-lg transition"
        >
          Cancel
        </button>
      </div>

      <div id="feedback_msg" class="text-sm mt-3"></div>
    </form>
  </div>

  <!-- Disclaimer -->
  <div class="mt-12 bg-gray-50 rounded-lg p-6">
    <h4 class="text-sm font-bold text-gray-700 mb-3">
      ℹ️ Important Information
    </h4>
    <ul class="text-xs text-gray-600 space-y-2">
      <li>
        • Estimates are based on average costs and standard plan coverage
        details
      </li>
      <li>
        • Actual costs may vary by ±20% depending on hospital choice,
        complications, and geographic location
      </li>
      <li>• Network discounts are applied automatically where applicable</li>
      <li>
        • These estimates don't account for pre-existing condition loadings or
        co-morbidities
      </li>
      <li>
        • Always confirm final costs with your insurance provider before
        proceeding
      </li>
    </ul>
  </div>
</div>

<script src="{{ url_for('static', filename='js/bill_buster_enhanced.js') }}?v=2"></script>
<script src="{{ url_for('static', filename='js/compare_modal.js') }}?v=2"></script>
<script src="{{ url_for('static', filename='js/bill_buster_preauth.js') }}?v=2"></script>
{% endblock %}
